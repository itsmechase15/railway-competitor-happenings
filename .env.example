# Every variable this app reads, with where the value comes from.
#
# This file is the shape, never the values. Copy it to .env for a local run –
# git ignores .env – and put the real values in the repo's Actions secrets for
# the daily job. `npm run check-env -- --strict` lists every variable and
# whether it is set. Only the required block below fails it.
#
# Required for a real run
# ---------------------------------------------------------------------------

# Postgres that remembers what has already been posted.
# Supabase → this bot's own project → Project Settings → Database → Connection
# string → Session pooler. It has to be the pooler URI: the direct
# db.<ref>.supabase.co host is IPv6 only and GitHub's runners have no IPv6
# route, so a direct URI works on a laptop and fails on every scheduled run.
# This bot has its own Supabase project. Never point it at another bot's.
DATABASE_URL=

# Posts the embed. discord.com/developers/applications → your app → Bot →
# Reset Token. Then invite the bot to the server with the OAuth2 URL generator
# (scope: bot) and give it View Channel, Send Messages, and Embed Links in the
# channel, or every post comes back as a missing-permission error.
DISCORD_BOT_TOKEN=
# The channel it posts to – yours, not a default. In Discord: Settings →
# Advanced → Developer Mode, then right-click the channel → Copy Channel ID.
# An 18-or-19-digit number. Nothing is delivered until this is set; the app
# will not guess.
DISCORD_CHANNEL_ID=

# Runs the Opus analysis that turns a launch into recommended actions.
# cursor.com/dashboard → Integrations → API Keys → Create key.
# Unset falls back to restating the source, labeled "not model-analyzed".
CURSOR_API_KEY=

# Sources – optional. Each one is skipped, with a log line, when its key is
# unset, and the run posts everything else. Never a check-env failure.
# ---------------------------------------------------------------------------

# The last few posts from @render and @vercel.
# developer.x.com → Projects & Apps → your app → Keys and tokens → Bearer Token.
X_BEARER_TOKEN=

# GitHub issues – one per recommended action, linked from the embed
# ---------------------------------------------------------------------------

# Actions provides this for free and the workflows grant it issues: write.
# Locally, a PAT with repo scope. Unset skips issue creation and still posts.
GITHUB_TOKEN=
# owner/repo the issues are filed against. Actions sets this to the running
# repo, so a fork files its own issues without any change here.
GITHUB_REPOSITORY=itsmechase15/railway-competitor-happenings

# Run modes
# ---------------------------------------------------------------------------

# Print the Discord payloads instead of posting, and skip all database writes
DRY_RUN=false
# Analyze the first-run backlog instead of recording it silently. Dry runs only.
FORCE_ANALYZE=false

# The review pass (defaults shown)
# ---------------------------------------------------------------------------
# Once an action's issue is open, a second model reads the same docs corpus and
# says agree, revise, or drop. A revise is rewritten by the analyst's model and
# then put back through the same evidence checks in code; a rewrite that fails
# them is thrown away and the original issue stands. It runs once per action.

# The reviewer. A different model from the analyst on purpose: the model that
# wrote a confident wrong claim is the worst judge of it. A model id your API key
# cannot run skips the review and labels the issue review:skipped.
# REVIEW_MODEL=claude-fable-5-1
# The model that applies a revise. Defaults to CURSOR_MODEL.
# UPDATER_MODEL=claude-opus-5
# Turn the review off for a fast local run. The daily job leaves this unset.
# SKIP_REVIEW=false
# Reviews allowed in one run. Past it, an action is filed as written and
# labelled review:skipped.
# REVIEW_MAX_PER_RUN=12

# Tuning (defaults shown)
# ---------------------------------------------------------------------------
# CURSOR_MODEL=claude-opus-5
# CURSOR_RUNTIME=local
# LOOKBACK_DAYS=7
# MAX_ITEMS_PER_RUN=12
# MAX_ITEMS_PER_SOURCE=8
# Railway docs corpus. The `pages` table is the source of truth for what
# Railway documents; these bound how it is discovered and kept current.
# How many pages one run may read. The default covers the whole of Railway's
# docs, which takes under twenty seconds, so the first run builds the whole
# corpus instead of a slice of it.
# RAILWAY_MAX_PAGES=600
# Re-read a page this many days after the last read, when nothing has reasoned
# against it lately. Pages an analyst read recently use the shorter tier.
# RAILWAY_REFRESH_DAYS=14
# DOCS_HOT_REFRESH_DAYS=3
# SKIP_RAILWAY_INDEX=false
# Discovery inputs. The union is the corpus: no one of these is trusted to be
# complete, and llms.txt least of all, since it is a curated subset.
# DOCS_SITEMAPS=https://docs.railway.com/sitemap.xml
# DOCS_LLMS_TXT=https://docs.railway.com/llms.txt
# Railway's own changelog. Its entries are evidence that something shipped,
# and no evidence that the docs mention it.
# RAILWAY_CHANGELOG_INDEX=https://railway.com/changelog
# Set once to fill an empty corpus in a single request instead of over several
# runs. Never read again after that, and never treated as current.
# DOCS_LLMS_FULL_TXT=https://docs.railway.com/llms-full.txt
# Where the per-run markdown copy of the corpus is written for the analyst to
# search. Rebuilt every run; git ignores it.
# DOCS_WORKSPACE_DIR=.docs-workspace
# How many corpus excerpts are pre-loaded into a prompt, and how many of them
# may come from one docs section.
# RETRIEVAL_TOP_K=10
# RETRIEVAL_PER_SECTION=4
# HTTP_TIMEOUT_MS=20000
# LOG_LEVEL=info
# USER_AGENT=railway-competitor-happenings/0.1 (+https://github.com/itsmechase15/railway-competitor-happenings)
# Screenshot renderers, tried in order. {encodedUrl} is the one that keeps an
# anchor, which is how a changelog entry on a shared page gets its own picture.
# SCREENSHOT_URL_TEMPLATE=https://api.microlink.io/?url={encodedUrl}&screenshot=true&meta=false&embed=screenshot.url,https://image.thum.io/get/width/1200/crop/900/noanimate/{url}
